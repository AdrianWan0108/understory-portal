# Existing Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Finance access grant script (used only by npm run finance:grant-access)
ADRIAN_EMAIL=adrian@example.com
KAREN_EMAIL=karen@example.com

# Zoho Books server-based OAuth application
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=https://portal.example.com/api/team-hub/finance/zoho/callback
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zohocloud.ca
ZOHO_BOOKS_BASE_URL=https://www.zohoapis.ca/books/v3
# Required when the Zoho account has multiple Books organizations
ZOHO_ORGANIZATION_NAME=Your Zoho Books organization name

# 32 random bytes encoded as base64 or 64 hex characters
TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-key

# Exact public portal origin, used for CSRF origin checks
FRONTEND_URL=https://portal.example.com
