# Existing Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Slack channels and protected scheduled jobs
SLACK_WEBHOOK_MVP=https://hooks.slack.com/services/...
SLACK_WEBHOOK_BOARDWALK=https://hooks.slack.com/services/...
SLACK_WEBHOOK_ADMIN=https://hooks.slack.com/services/...
CRON_SECRET=replace-with-a-long-random-value

# 32 random bytes encoded as base64 or 64 hex characters
TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-key

# Exact public portal origin, used for CSRF origin checks
FRONTEND_URL=https://portal.example.com

# Server-only key for importing publicly shared Google Drive folders
GOOGLE_DRIVE_API_KEY=your-google-drive-api-key

# Server-only AI provider keys. ChatGPT and Perplexity web subscriptions do
# not authenticate API requests; create keys in each provider's API console.
OPENAI_API_KEY=your-openai-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional model and budget overrides
OPENAI_CONTENT_MODEL=gpt-5.6-terra
PERPLEXITY_RESEARCH_MODEL=sonar-pro
ASSISTANT_MONTHLY_BUDGET_USD=20
